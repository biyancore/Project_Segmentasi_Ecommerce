   "source": [
    "fitur_iqr = ['Tenure', 'WarehouseToHome', 'HourSpendOnApp',\n",
    "    'NumberOfDeviceRegistered', 'NumberOfAddress', 'OrderAmountHikeFromlastYear',\n",
    "    'CouponUsed', 'OrderCount', 'DaySinceLastOrder', 'CashbackAmount']\n",
    "def tabel_iqr(data):\n",
    "    records = []\n",
    "    for col in fitur_iqr:\n",
    "        s = data[col].dropna()\n",
    "        q1, q3 = s.quantile([.25, .75])\n",
    "        iqr = q3 - q1\n",
    "        lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "        flagged = (s < lower) | (s > upper)\n",
    "        records.append({'Kolom': col, 'N tersedia': len(s), 'Q1': q1, 'Q3': q3,\n",
    "            'Batas bawah': lower, 'Batas atas': upper, 'Minimum': s.min(),\n",
    "            'Maksimum': s.max(), 'Jumlah outlier': int(flagged.sum()),\n",
    "            'Persen outlier': round(flagged.mean() * 100, 2)})\n",
    "    return pd.DataFrame(records).set_index('Kolom')\n",
    "outlier_awal = tabel_iqr(df)\n",
    "display(outlier_awal.round(2))"
   ]
  },
